# Base URL of the running InvenTree instance
INVENTREE_BASE_URL=http://localhost:8000

# Superuser or test-account credentials (used to fetch an auth token in fixtures/api-client.ts)
INVENTREE_USERNAME=admin
INVENTREE_PASSWORD=change-me

# Optional: a static API token, if you prefer not to authenticate via username/password each run
# INVENTREE_API_TOKEN=
